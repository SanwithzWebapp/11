<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css">

  <!-- jQuery -->
  <script src="https://code.jquery.com/jquery-3.6.0.js"></script>

  <!-- Sweet Alert -->
  <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <!-- Loading Overlay -->
  <script src="https://cdn.jsdelivr.net/npm/gasparesganga-jquery-loading-overlay@2.1.7/dist/loadingoverlay.min.js"></script>

  <!-- LIFF SDK -->
  <script src="https://static.line-scdn.net/liff/edge/2/sdk.js"></script>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Prompt");

    * {
      box-sizing: border-box;
      font-family: "Prompt", sans-serif;
    }

    #total-score {
      text-align: right;
    }

    footer {
      margin-top: 10px;
      background-color: #000;
      width: 100%;
      padding: 2px;
      position: fixed;
      bottom: 0;
    }

    footer p,
    footer a {
      text-decoration: none;
      margin: 0;
    }

    footer .fa {
      color: #fff740;
    }

    .small-font {
      font-size: 0.875rem;
    }
  </style>

  <title>Biology | Mr. Sittichart</title>
</head>

<body>
  <div class="max-w-4xl mx-auto p-2">
    <div class="bg-yellow-400 rounded-t-lg p-4 text-center text-gray-800 font-bold text-xl relative">
      Biology | Mr. Sittichart
      <div id="countdown" class="text-sm mt-2">Ends in 19h 57m</div>
    </div>

    <div class="bg-beige-300 rounded-r-lg p-4 text-center">
      <h2>Line ID : <span id="user-name" class="font-bold text-xl text-gray-800 mb-2"></span> </h2>

      <img id="user-image" src="https://iili.io/d5Sgtl1.png" style="width: 150px;" alt="Reward chest with a blue pig-like creature" class="mx-auto mb-2">
      <h2 id="user-fullname" class="font-bold text-xl text-gray-800 mb-2"></h2>
      <h2 id="user-classroom" class="font-bold text-xl text-gray-800 mb-4"></h2>

      <div id="reward-container" class="flex justify-center space-x-1 mb-4">
        <!-- Reward divs will be appended here -->
      </div>
      <button id="battle-button" class="bg-yellow-400 text-gray-800 font-bold py-2 px-4 rounded-lg">0/0 BATTLE</button>
    </div>

    <div class="bg-purple-400 text-white p-4">
      <div class="grid grid-cols-6 text-lg font-bold mb-2">
        <span class="col-span-4 text-center small-font ">หน่วยการเรียนรู้</span>
        <span class="col-span-1 text-center small-font">คะแนนเต็ม</span>
        <span class="col-span-1 text-center small-font">ผลการประเมิน</span>
      </div>
      <div id="data-container" class="space-y-2">
        <!-- Data will be appended here -->
      </div>
      <div id="total-score" class="bg-yellow-400 text-gray-800 font-bold py-2 px-4 rounded-lg mt-3"></div> <!-- Placeholder for total score -->
    </div>

  </div>

  <script>
    // Initialize LIFF
    async function initializeLiff() {
      await liff.init({ liffId: "XXXXXXXXX" }); // แก้ไข 1
      if (liff.isLoggedIn()) {
        getUserProfile();
      } else {
        liff.login();
      }
    }

    // Fetch user profile
    async function getUserProfile() {
      const profile = await liff.getProfile();
      document.getElementById('user-name').textContent = profile.displayName;
      document.getElementById('user-image').src = profile.pictureUrl || ''; // Show blank if undefined
      fetchData(profile.userId);
    }

    // Fetch data from JSON URL and filter based on user ID
    async function fetchData(userId) {
      const response = await fetch('https://opensheet.elk.sh/XXXXXXXXXX/Score'); // แก้ไข 2
      const data = await response.json();
      const filteredData = data.filter(item => item.UID === userId);
      displayData(filteredData);
      displayRewards(filteredData);
      displayUserInfo(filteredData);
      displayTotalScore(filteredData); // Calculate and display the total score
    }

    // Display filtered data
    function displayData(data) {
      const container = document.getElementById('data-container');
      container.innerHTML = '';
      data.forEach(item => {
        const chapter = item.Chapter || ''; // Show blank if undefined
        const target = item.Target || '';   // Show blank if undefined
        const score = item.Score || '';     // Show blank if undefined
        const imgTag = item.Reward ? `<img src="${item.Reward}" class="col-span-1 mx-auto" style="width: 30px;" alt="Reward icon">` : '';
        const row = `
          <div class="grid grid-cols-6 items-center bg-purple-700 p-2 rounded">
            <span class="col-span-4 text-center">${chapter}</span>
            <span class="col-span-1 text-center">${target}</span>
            <span class="col-span-1 text-center">${imgTag}</span>
                        <!--<span class="col-span-1 text-center">${score}</span>-->
          </div>
        `;
        container.innerHTML += row;
      });
    }


// Display rewards and count non-grey rewards
function displayRewards(data) {
  const rewardContainer = document.getElementById('reward-container');
  rewardContainer.innerHTML = '';
  let nonGreyCount = 0;

  data.forEach(item => {
    let colorClass = "bg-gray-300"; // Default to gray if no score
    const target = parseFloat(item.Target) || 0; // Default to 0 if undefined
    const score = parseFloat(item.Score);   // Keep undefined if no score
    
    if (score !== undefined && !isNaN(score)) {
      const percentage = (score / target) * 100;

      if (percentage > 74.5) {
        colorClass = "bg-green-300"; // Green for > 75%
        nonGreyCount++;
      } else if (percentage > 49.5) {
        colorClass = "bg-yellow-300"; // Yellow for > 50%
        nonGreyCount++;
      } else if (percentage <= 49.5 && percentage > 0) {
        colorClass = "bg-red-300"; // Red for <= 50%
        nonGreyCount++;
      }
    }

    const rewardDiv = `<div class="w-8 h-8 ${colorClass} rounded"></div>`;
    rewardContainer.innerHTML += rewardDiv;
  });

  // Update battle button text with non-grey count and total data length
  const battleButton = document.getElementById('battle-button');
  battleButton.textContent = ` เรียนรู้ไปแล้ว ${nonGreyCount}/${data.length} หน่วยการเรียนรู้`;
}


    // Display user information
    function displayUserInfo(data) {
      if (data.length > 0) {
        const user = data[0];
        document.getElementById('user-fullname').textContent = `${user.StudentName || ''}`; // Show blank if undefined
        document.getElementById('user-classroom').textContent = `ห้อง : ${user.Classroom || ''}`; // Show blank if undefined
      }
    }

    // Display total score
    function displayTotalScore(data) {
      const totalScore = data.reduce((total, item) => {
        const score = parseFloat(item.Score) || 0; // Default to 0 if undefined
        return total + score;
      }, 0);
      document.getElementById('total-score').textContent = `คะแนนรวม: ${totalScore}/100 คะแนน`; // Display the total score
    }

    // Countdown timer
    function countdownTimer(targetDate, countdownId) {
      const countdownElement = document.getElementById(countdownId);

      function updateCountdown() {
        const now = new Date();
        const timeRemaining = targetDate - now;

        if (timeRemaining <= 0) {
          countdownElement.innerHTML = '<div>Event Ended!</div>';
          return;
        }

        const days = Math.floor(timeRemaining / (1000 * 60 * 60 * 24));
        const hours = Math.floor((timeRemaining % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((timeRemaining % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((timeRemaining % (1000 * 60)) / 1000);

        countdownElement.textContent = `เหลือเวลาอีก ${days} วัน ${hours} ชั่วโมง ${minutes} นาที ${seconds} วินาที`;
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    }

    // Initialize LIFF on page load
    window.onload = function () {
      initializeLiff();
      const targetDate = new Date('2024-09-30T00:00:00'); // Set your target date
      countdownTimer(targetDate, 'countdown');
    }
  </script>

  <footer class="text-center text-lg-start bg-light text-muted" style="  position: static;left: 0;bottom: 0;width: 100%;">
    <div class="text-center p-4" style=" font-size: 14px; background-color: rgba(0, 0, 0, 0.05);">
      © <script>document.write(new Date().getFullYear());</script> Copyright | พัฒนาโดยครูสิทธิชาติ สิทธิ
    </div>
  </footer>

</body>

</html>
